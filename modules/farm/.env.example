# Public credentials only. Never put service_role, secret keys or a database password here.
FARM_LAB_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
FARM_LAB_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_OR_ANON_KEY

# Optional: Node-only migration tools. Prefer the Session pooler on IPv4 networks.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@SESSION_POOLER_HOST:5432/postgres
